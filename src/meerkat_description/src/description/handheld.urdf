<?xml version="1.0"?>
<robot name="hand_lidar">

  <!-- Simple material -->
  <material name="dark">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <!-- ============== base_link (box) ============== -->
  <!-- Defaults applied: length=0.30, width=0.20, height=0.02, mass=0.8 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.20 0.02"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.20 0.02"/>
      </geometry>
    </collision>

    <!-- Box inertia: Ixx = 1/12 m (y^2 + z^2), etc. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.0026933333333333336" ixy="0" ixz="0"
        iyy="0.006026666666666666"  iyz="0"
        izz="0.008666666666666666"/>
    </inertial>
  </link>

  <!-- ============== Ouster frame (driver publishes this) ============== -->
  <link name="os_sensor"/>
  <joint name="base_to_os" type="fixed">
    <parent link="base_link"/>
    <child  link="os_sensor"/>
    <!-- Mount pose relative to base_link -->
    <origin xyz="0.00 0.00 0.02" rpy="0 0 0"/>
  </joint>
<!-- 
  <link name="vectornav"> 
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vectornav"/>
    <origin xyz="0.085 0.0 -0.035" rpy="0 0 0"/>
  </joint>
 

 -->



  <!-- ============== ZED frame (driver publishes this) ============== -->
  <link name="vectornav"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="vectornav"/>
    
    <origin xyz="0.05 0.00 -0.05" rpy="0 0 0"/>
  </joint>
</robot>

  <!-- Optional: add optical frame if your ZED stack doesn't already provide it
  <link name="zed_camera_optical_frame"/>
  <joint name="zed_optical_from_zed_frame" type="fixed">
    <parent link="zed_camera_link"/>
    <child  link="zed_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  -->

